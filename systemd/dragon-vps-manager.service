[Unit]
Description=Dragon VPS Manager NG
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dragon-vps-manager-ng
Environment=DRAGON_DATA_DIR=/opt/dragon-vps-manager-ng/data
ExecStart=/opt/dragon-vps-manager-ng/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dragon-vps-manager-ng/data /home /etc

[Install]
WantedBy=multi-user.target
