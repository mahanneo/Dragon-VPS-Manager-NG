[Unit]
Description=Makia VPS Manager Metrics Sampler
After=network.target makia-vps-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
ExecStart=/opt/makia-vps-manager/.venv/bin/python -m app.metrics_sampler
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/makia-vps-manager/data

[Install]
WantedBy=multi-user.target
