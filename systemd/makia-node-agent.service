[Unit]
Description=Makia Lightweight Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/makia-node-agent.env
ExecStart=/usr/bin/python3 /opt/makia-node-agent/agent.py
Restart=always
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
