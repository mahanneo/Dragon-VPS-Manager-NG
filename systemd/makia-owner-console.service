[Unit]
Description=Makia Owner Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=makia-owner
Group=makia-owner
WorkingDirectory=/opt/makia-owner-console
EnvironmentFile=/etc/makia-owner-console/owner.env
ExecStart=/opt/makia-owner-console/.venv/bin/uvicorn owner_console.app:app --host 127.0.0.1 --port 8790 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/etc/makia-owner-console
ReadWritePaths=/var/lib/makia-owner-console

[Install]
WantedBy=multi-user.target
