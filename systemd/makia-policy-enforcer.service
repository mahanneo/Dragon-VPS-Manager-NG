[Unit]
Description=Makia VPS Manager Account Policy Enforcer
After=network.target makia-vps-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
ExecStart=/opt/makia-vps-manager/.venv/bin/python -m app.policy_enforcer
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/makia-vps-manager/data /home /etc

[Install]
WantedBy=multi-user.target
