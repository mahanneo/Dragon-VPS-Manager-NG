[Unit]
Description=Makia Protocol Traffic Collector
After=network.target makia-vps-manager.service
Wants=makia-vps-manager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
ExecStart=/opt/makia-vps-manager/.venv/bin/python -m app.protocol_traffic
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/makia-vps-manager/data /usr/local/etc/xray /etc/xray -/var/backups/makia-vps-manager

[Install]
WantedBy=multi-user.target
