[Unit]
Description=Makia VPS Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/makia-vps-manager
Environment=MAKIA_DATA_DIR=/opt/makia-vps-manager/data
ExecStart=/opt/makia-vps-manager/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/makia-vps-manager/data /home /etc -/var/backups/makia-vps-manager

[Install]
WantedBy=multi-user.target
